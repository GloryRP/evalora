# MongoDB Connection URI
# For local: mongodb://localhost:27017/examdb
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/examdb
MONGO_URI=mongodb://localhost:27017/examdb

# JWT Secret - use a long random string in production
JWT_SECRET=your_jwt_secret_key_here_change_this

# Server Port
PORT=5000

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# ── Email / SMTP (Gmail) ──────────────────────────────────
# Use an App Password (NOT your real Gmail password)
# Steps: Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=Exam System <your_email@gmail.com>
